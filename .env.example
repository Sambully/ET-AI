# ── AirGuard AI — environment configuration ──────────────────────────────
# Copy this file to ".env" and fill in the keys you have. The app runs with
# graceful fallbacks for every key, so the demo works even with none set —
# but real keys make every number on screen live and defensible to judges.

# ── LLM provider ──────────────────────────────────────────────────────────
# Primary: Google Gemini. Free key (generous free tier) at:
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model. gemini-2.5-flash is fast and free-tier friendly (recommended
# for a live demo). For higher quality: gemini-3.5-flash or gemini-2.5-pro.
GEMINI_MODEL=gemini-2.5-flash

# Optional fallback: Anthropic Claude. Only used if GEMINI_API_KEY is blank.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# ── Geospatial / sensor data ──────────────────────────────────────────────
# OpenAQ v3 — live ground-station AQI. Free key at https://explore.openaq.org/
# (account → API keys). Without it, the app falls back to realistic seeded AQI.
OPENAQ_API_KEY=

# NASA FIRMS — live satellite fire hotspots. Free instant key at
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Open-Meteo (weather + air-quality forecast) needs NO key — used directly.

# ── Flask ─────────────────────────────────────────────────────────────────
FLASK_DEBUG=1
PORT=5000
